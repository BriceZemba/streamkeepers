    "item": [
     {
      "linkId": "step-water",
      "item": [
       {
        "linkId": "water_flow",
        "text": "How is the water moving?",
        "answer": [
         {
          "valueCoding": {
           "system": "https://api.enora-oah.eu/api/citizens/water_flows",
           "code": "NOR",
           "display": "Slow"
          }
         }
        ]
       }
      ]
     },
     {
      "linkId": "step-colour",
      "item": [
       {
        "linkId": "water_color",
        "text": "What does the water look like?",
        "answer": [
         {
          "valueCoding": {
           "system": "https://api.enora-oah.eu/api/citizens/water_colors",
           "code": "MU",
           "display": "Muddy/turbid"
          }
         },
         {
          "valueCoding": {
           "system": "https://api.enora-oah.eu/api/citizens/water_colors",
           "code": "FO",
           "display": "Has foam"
          }
         }
        ]
       }
      ]
     },
     {
      "linkId": "step-channel",
      "item": [
       {
        "linkId": "channel_type",
        "text": "What is the stream bed made of?",
        "answer": [
         {
          "valueCoding": {
           "system": "https://api.enora-oah.eu/api/citizens/channel_types",
           "code": "ART",
           "display": "Artificial (concrete or stones with concrete)"
          }
         }
        ]
       },
       {
        "linkId": "channel_form",
        "text": "What shape is the stream bed?",
        "answer": [
         {
          "valueCoding": {
           "system": "https://api.enora-oah.eu/api/citizens/channel_forms",
           "code": "U",
           "display": "U Shape"
          }
         }
        ]
       },
       {
        "linkId": "bank_type",
        "text": "What are the banks made of?",
        "answer": [
         {
          "valueCoding": {
           "system": "https://api.enora-oah.eu/api/citizens/bank_types",
           "code": "LAS",
           "display": "Layed stones with no concrete"
          }
         }
        ]
       }
      ]
     },
     {
      "linkId": "step-life",
      "item": [
       {
        "linkId": "habitats",
        "text": "Which of these can you see in the water?",
        "answer": [
         {
          "valueCoding": {
           "system": "https://api.enora-oah.eu/api/citizens/habitats",
           "code": "SD",
           "display": "Stone deposits"
          }
         }
        ]
       },
       {
        "linkId": "fallen_biomass",
        "text": "Is there wood or leaves in the stream?",
        "answer": [
         {
          "valueCoding": {
           "system": "https://github.com/BriceZemba/streamkeepers/fhir/CodeSystem/streamkeepers",
           "code": "none-of-these",
           "display": "None of these"
          }
         }
        ]
       }
      ]
     },
     {
      "linkId": "step-pressures",
      "item": [
       {
        "linkId": "draining_pipes",
        "text": "Do pipes flow into the stream?",
        "answer": [
         {
          "valueCoding": {
           "system": "https://github.com/BriceZemba/streamkeepers/fhir/CodeSystem/streamkeepers-draining-pipes",
           "code": "FLOWING",
           "display": "Pipes with water coming out"
          }
         }
        ]
       },
       {
        "linkId": "sewage_signs",
        "text": "Any sewage smell, grey water or toilet paper?",
        "answer": [
         {
          "valueCoding": {
           "system": "https://github.com/BriceZemba/streamkeepers/fhir/CodeSystem/streamkeepers-sewage-signs",
           "code": "YES",
           "display": "Yes"
          }
         }
        ]
       },
       {
        "linkId": "barriers",
        "text": "Is something blocking the flow?",
        "answer": [
         {
          "valueCoding": {
           "system": "https://github.com/BriceZemba/streamkeepers/fhir/CodeSystem/streamkeepers-barriers",
           "code": "NO",
           "display": "No"
          }
         }
        ]
       },
       {
        "linkId": "construction",
        "text": "Are there works in or next to the stream?",
        "answer": [
         {
          "valueCoding": {
           "system": "https://github.com/BriceZemba/streamkeepers/fhir/CodeSystem/streamkeepers-construction",
           "code": "NO",
           "display": "No"
          }
         }
        ]
       },
       {
        "linkId": "invasive_species",
        "text": "Did you see plants or animals that don't belong here?",
        "answer": [
         {
          "valueCoding": {
           "system": "https://github.com/BriceZemba/streamkeepers/fhir/CodeSystem/streamkeepers",
           "code": "not-sure",
           "display": "Not sure"
          }
         }
        ]
       }
      ]
     },
     {
      "linkId": "step-banks",
      "item": [
       {
        "linkId": "vegetation_left",
        "text": "Plants on the left bank (looking downstream)",
        "answer": [
         {
          "valueCoding": {
           "system": "https://api.enora-oah.eu/api/citizens/vegetation_types",
           "code": "H",
           "display": "Herbs"
          }
         },
         {
          "valueCoding": {
           "system": "https://api.enora-oah.eu/api/citizens/vegetation_types",
           "code": "B",
           "display": "Shrubs"
          }
         }
        ]
       },
       {
        "linkId": "vegetation_right",
        "text": "Plants on the right bank",
        "answer": [
         {
          "valueCoding": {
           "system": "https://api.enora-oah.eu/api/citizens/vegetation_types",
           "code": "T",
           "display": "Trees"
          }
         }
        ]
       },
       {
        "linkId": "impervious",
        "text": "How much of the banks is paved or built on?",
        "answer": [
         {
          "valueCoding": {
           "system": "https://github.com/BriceZemba/streamkeepers/fhir/CodeSystem/streamkeepers-impervious",
           "code": "SOME",
           "display": "Some"
          }
         }
        ]
       }
      ]
     },
     {
      "linkId": "step-overall",
      "item": [
       {
        "linkId": "overall",
        "text": "Overall, how healthy does this stream look?",
        "answer": [
